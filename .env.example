APP_NAME=notification-platform
APP_VERSION=0.0.1
APP_JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_32+_CHARS
APP_JWT_TTL_MINUTES=120
APP_OUTBOX_PUBLISHER_DELAY_MS=1000

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/notification
SPRING_DATASOURCE_USERNAME=notification
SPRING_DATASOURCE_PASSWORD=notification
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

APP_EMAIL_FROM=no-reply@notification-platform.local
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

APP_TELEGRAM_BASE_URL=https://api.telegram.org
APP_TELEGRAM_BOT_TOKEN=
APP_WEBHOOK_SECRET=local-webhook-secret

LOG_FILE=/var/log/notification-platform/notification-platform.json
